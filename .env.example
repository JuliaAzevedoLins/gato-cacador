# Copie este arquivo para ".env" e preencha com os seus dados.
# NUNCA suba o .env para o GitHub (ele já está no .gitignore).

# Token do bot, gerado pelo @BotFather no Telegram
TELEGRAM_BOT_TOKEN=

# ID do chat que vai receber os alertas (dá pra descobrir pela aba 🔔 Alertas)
TELEGRAM_CHAT_ID=

# Navegador do robô: auto (Chrome e, se o Windows bloquear, Edge), chrome ou edge
NAVEGADOR=auto
